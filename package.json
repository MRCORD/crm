{
  "name": "agentic-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:tunnel": "trap 'kill 0' EXIT; cloudflared tunnel --config ~/.cloudflared/crm-config.yml run & next dev --port 3011",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "deploy:worker": "opennextjs-cloudflare build && wrangler deploy",
    "start": "next start",
    "lint": "eslint .",
    "mcp": "tsx src/mcp/stdio.ts",
    "db:init": "tsx src/db/init.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "auth:promote": "tsx src/db/scripts/promote-admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.39.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "polygres-sdk-ts": "^0.4.1",
    "postcss": "^8.5.28",
    "postgres": "^3.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "svix": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "wrangler": "^4.132.0"
  }
}
