# ============================================================
# Agentic CRM — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# ---- Database (Polygres / PostgreSQL) ----------------------
# Primary connection string used by Drizzle ORM at runtime.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
# Direct (non-pooled) connection used by Drizzle Kit for migrations.
# For Polygres: same as DATABASE_URL. For PgBouncer setups: the direct port.
DIRECT_URL=postgres://postgres:postgres@localhost:5432/crm

# ---- Polygres ----------------------------------------------
# Project API key from https://polygres.com → Project Settings → API Keys
POLYGRES_API_KEY=poly_live_your_api_key_here
# Polygres runtime URL (default is correct for hosted Polygres)
POLYGRES_RUNTIME_URL=https://runtime.polygres.com

# ---- Clerk Authentication ----------------------------------
# From https://clerk.com → Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# From Clerk Dashboard → Webhooks → Add Endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# ---- Optional Integrations ---------------------------------
# Anthropic API key (if running agents via Anthropic SDK directly)
ANTHROPIC_API_KEY=sk-ant-your_key_here
# PostHog webhook ingestion secret
POSTHOG_WEBHOOK_SECRET=ph_secret_here
