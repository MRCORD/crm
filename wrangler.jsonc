{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic-crm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "YOUR_HYPERDRIVE_CONFIG_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
