{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mysios-crm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8537c175315b411b97e185b974f495ef"
    }
  ],
  "routes": [
    {
      "pattern": "crm.mysioslabs.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
